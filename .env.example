# Copy to .env.local. Do not commit real secrets.
# This Supabase project belongs to the Lumen website only.

# Transaction pooler URI from the project's Connect page (port 6543).
# Username is postgres.<project-ref>. Direct db.*.supabase.co hosts are IPv6-only.
# Session pooler (port 5432) is for long-lived VMs, not Next.js.
# Never prefix this name with NEXT_PUBLIC_.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Random server-only string of at least 32 characters. All website instances must share it.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never prefix this name with NEXT_PUBLIC_.
LUMEN_FORM_SECRET=PASTE_RANDOM_SERVER_ONLY_SECRET_HERE

# Exact browser origins allowed to submit the form. No wildcards.
LUMEN_ALLOWED_ORIGINS=http://localhost:3000

# Leave unset locally. Set only to a header your trusted proxy overwrites, such as x-real-ip.
# The website ignores X-Forwarded-For unless you name that header here.
LUMEN_TRUSTED_IP_HEADER=
